{
  "schema_version": 1,
  "executor": "chapter_tools",
  "actions": [
    "write_draft",
    "write_review",
    "write_review_accept"
  ],
  "description": "先保证授权草稿存在，按当前状态审核及限内修订；只有原目标含接受才提交。",
  "steps": [
    {
      "id": "draft",
      "tool": "chapter.write",
      "when": "draft_missing",
      "required": true,
      "instruction": "仅在授权范围尚无有效草稿时由Writer起草；已有同版草稿保留并复用。完整交正文及必要候选附件，不提前审查、接受或扩章。"
    },
    {
      "id": "review",
      "tool": "chapter.review_mode",
      "when": "review_needed",
      "required": true,
      "actions": [
        "write_review",
        "write_review_accept"
      ],
      "depends_on": [
        "draft"
      ],
      "instruction": "只审核当前章当前版本，按本次分工核正文与记忆候选；判断引用实际来源，缺证先补核。只审查不改稿，不把模型通过当正式接受；同版有效结果复用。"
    },
    {
      "id": "repair-one",
      "tool": "chapter.revise",
      "when": "revision_needed",
      "required": false,
      "default": true,
      "round": 1,
      "actions": [
        "write_review",
        "write_review_accept"
      ],
      "depends_on": [
        "review"
      ],
      "instruction": "仅修当前版本已核实且属于原授权的问题和必要衔接，保留其余内容、人物知情与物件状态。资料不足或判断未定先核依据，不用改稿消除无依据指控。"
    },
    {
      "id": "recheck-one",
      "tool": "chapter.review_mode",
      "when": "review_needed",
      "required": true,
      "round": 1,
      "actions": [
        "write_review",
        "write_review_accept"
      ],
      "depends_on": [
        "repair-one"
      ],
      "instruction": "核修订后的当前版本，旧版审核不能签新版；有效同版检查复用，缺证留待核，不为走满流程再修一次。"
    },
    {
      "id": "repair-two",
      "tool": "chapter.revise",
      "when": "revision_needed",
      "required": false,
      "default": true,
      "round": 2,
      "actions": [
        "write_review",
        "write_review_accept"
      ],
      "depends_on": [
        "recheck-one"
      ],
      "instruction": "仅修当前版本已核实且属于原授权的问题和必要衔接，保留其余内容、人物知情与物件状态。资料不足或判断未定先核依据，不用改稿消除无依据指控。"
    },
    {
      "id": "recheck-two",
      "tool": "chapter.review_mode",
      "when": "review_needed",
      "required": true,
      "round": 2,
      "actions": [
        "write_review",
        "write_review_accept"
      ],
      "depends_on": [
        "repair-two"
      ],
      "instruction": "只核本轮修后的当前版本及必要影响；仍有缺口保留实际断点，不重置原修订轮次或费用。"
    },
    {
      "id": "accept",
      "tool": "chapter.accept",
      "when": "ready_to_accept",
      "required": true,
      "actions": [
        "write_review_accept"
      ],
      "depends_on": [
        "recheck-two"
      ],
      "instruction": "仅在原目标明确包含接受、当前正文与来源版本一致、必要审核及记忆条件满足时，交原引擎正式接受；不以技能或模型自述代替门禁，已提交结果不重复写入。"
    }
  ]
}

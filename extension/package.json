{
  "name": "inkflow-vscode",
  "displayName": "inkflow墨流",
  "description": "四 Agent 中文长篇小说创作工作台：Coordinator、写作、证据化审查、正史记忆与安全回退",
  "version": "0.4.0",
  "publisher": "inkflow",
  "license": "MIT",
  "icon": "media/mobao.png",
  "pricing": "Free",
  "galleryBanner": { "color": "#181a14", "theme": "dark" },
  "homepage": "https://github.com/littlewinter320/inkflow#readme",
  "bugs": { "url": "https://github.com/littlewinter320/inkflow/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/littlewinter320/inkflow.git"
  },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["小说", "网文", "写作", "中文写作", "人工智能", "novel", "writing", "agent", "mcp"],
  "activationEvents": ["workspaceContains:.inkflow/project.json", "onView:inkflow.control", "onView:inkflow.explorer"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && vsce package --no-dependencies -o ../artifacts/extension/inkflow-vscode-0.4.0.vsix"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "inkflow", "title": "墨流", "icon": "media/inkflow.svg" }
      ]
    },
    "views": {
      "inkflow": [
        { "id": "inkflow.control", "name": "创作主控", "type": "webview" },
        { "id": "inkflow.explorer", "name": "小说结构" }
      ]
    },
    "commands": [
      { "command": "inkflow.refresh", "title": "墨流：刷新小说树", "icon": "$(refresh)" },
      { "command": "inkflow.ask", "title": "墨流：自然语言讨论或安排任务", "icon": "$(comment-discussion)" },
      { "command": "inkflow.generatePlan", "title": "墨流：生成四级规划", "icon": "$(map)" },
      { "command": "inkflow.writeChapter", "title": "墨流：写当前章节草稿", "icon": "$(edit)" },
      { "command": "inkflow.acceptChapter", "title": "墨流：验收当前章节进入正史", "icon": "$(check)" },
      { "command": "inkflow.configureMcp", "title": "墨流：为当前工作区配置 MCP" },
      { "command": "inkflow.commentSelection", "title": "墨流：批注选中文字" },
      { "command": "inkflow.reviseSelection", "title": "墨流：让写作角色修订选中文字" },
      { "command": "inkflow.reviewChapter", "title": "墨流：让审查角色检查当前章节" },
      { "command": "inkflow.openStatus", "title": "墨流：打开项目状态" },
      { "command": "inkflow.createCheckpoint", "title": "墨流：创建安全检查点" },
      { "command": "inkflow.openTaskHistory", "title": "墨流：查看任务记录" },
      { "command": "inkflow.openDesktop", "title": "墨流：在桌面版中打开" }
    ],
    "menus": {
      "view/title": [
        { "command": "inkflow.ask", "when": "view == inkflow.control", "group": "navigation@1" },
        { "command": "inkflow.refresh", "when": "view == inkflow.control", "group": "navigation@2" },
        { "command": "inkflow.refresh", "when": "view == inkflow.explorer", "group": "navigation" },
        { "command": "inkflow.configureMcp", "when": "view == inkflow.explorer", "group": "navigation" },
        { "command": "inkflow.createCheckpoint", "when": "view == inkflow.explorer", "group": "navigation" },
        { "command": "inkflow.openTaskHistory", "when": "view == inkflow.explorer", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "inkflow.commentSelection", "when": "editorHasSelection && resourceExtname == .md", "group": "inkflow@1" },
        { "command": "inkflow.reviseSelection", "when": "editorHasSelection && resourceExtname == .md", "group": "inkflow@2" },
        { "command": "inkflow.reviewChapter", "when": "resourceFilename =~ /chapter_\\d+.*\\.md/", "group": "inkflow@3" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "inkflow.explorer",
        "contents": "请先打开包含 `.inkflow/project.json` 的墨流小说项目。\n[打开项目文件夹](command:workbench.action.files.openFolder)\n[打开墨流桌面版](command:inkflow.openDesktop)",
        "when": "!inkflow.project"
      }
    ],
    "walkthroughs": [
      {
        "id": "inkflow.gettingStarted",
        "title": "开始使用墨流",
        "description": "从打开项目到完成一章的中文长篇创作流程。",
        "steps": [
          { "id": "open", "title": "打开墨流小说项目", "description": "先用桌面版新建小说，或打开已有的墨流项目文件夹。", "media": { "markdown": "media/walkthrough-open.md" } },
          { "id": "plan", "title": "生成四级规划", "description": "先由 Coordinator 理解方向，再安排生成全书、卷、篇章和章节卡。", "media": { "markdown": "media/walkthrough-plan.md" } },
          { "id": "draft", "title": "写作与审查", "description": "写作角色生成草稿，审查角色给出证据与扣分；你确认后才进入正史。", "media": { "markdown": "media/walkthrough-draft.md" } },
          { "id": "connect", "title": "连接编程助手", "description": "把墨流合并到当前工作区的 MCP 配置，用自然语言调用同一套引擎。", "media": { "markdown": "media/walkthrough-connect.md" } }
        ]
      }
    ],
    "configuration": {
      "title": "墨流 InkFlow",
      "properties": {
        "inkflow.enginePath": {
          "type": "string",
          "default": "",
          "description": "可选：inkflow-engine.exe 的完整路径。留空时自动寻找桌面版或工作区 Python 环境。"
        },
        "inkflow.pythonPath": {
          "type": "string",
          "default": "",
          "description": "可选：用于运行 inkflow.app_server 的 Python 路径。"
        },
        "inkflow.revealCharactersPerSecond": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 60,
          "description": "对话答复逐字淡入速度。开启系统“减少动态效果”时会立即显示。"
        }
      }
    }
  }
}

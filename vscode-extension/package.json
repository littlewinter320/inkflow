{
  "name": "inkflow-vscode",
  "displayName": "墨流 InkFlow",
  "description": "在 VS Code 中使用墨流三 Agent 长篇小说工作流",
  "version": "0.2.0",
  "publisher": "inkflow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/littlewinter320/inkflow.git"
  },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["novel", "writing", "中文网文", "agent", "mcp"],
  "activationEvents": ["workspaceContains:.inkflow/project.json", "onView:inkflow.explorer"],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && vsce package --no-dependencies -o release/inkflow-vscode-0.2.0.vsix"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "inkflow", "title": "墨流", "icon": "media/inkflow.svg" }
      ]
    },
    "views": {
      "inkflow": [
        { "id": "inkflow.explorer", "name": "小说工作台" }
      ]
    },
    "commands": [
      { "command": "inkflow.refresh", "title": "墨流：刷新小说树", "icon": "$(refresh)" },
      { "command": "inkflow.configureMcp", "title": "墨流：为当前工作区配置 MCP" },
      { "command": "inkflow.commentSelection", "title": "墨流：批注选中文字" },
      { "command": "inkflow.reviseSelection", "title": "墨流：让 Writer 修订选中文字" },
      { "command": "inkflow.reviewChapter", "title": "墨流：审查当前章节" },
      { "command": "inkflow.openStatus", "title": "墨流：打开项目状态" },
      { "command": "inkflow.createCheckpoint", "title": "墨流：创建安全检查点" },
      { "command": "inkflow.openTaskHistory", "title": "墨流：查看任务记录" },
      { "command": "inkflow.openDesktop", "title": "墨流：在桌面版中打开" }
    ],
    "menus": {
      "view/title": [
        { "command": "inkflow.refresh", "when": "view == inkflow.explorer", "group": "navigation" },
        { "command": "inkflow.configureMcp", "when": "view == inkflow.explorer", "group": "navigation" },
        { "command": "inkflow.createCheckpoint", "when": "view == inkflow.explorer", "group": "navigation" },
        { "command": "inkflow.openTaskHistory", "when": "view == inkflow.explorer", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "inkflow.commentSelection", "when": "editorHasSelection && resourceExtname == .md", "group": "inkflow@1" },
        { "command": "inkflow.reviseSelection", "when": "editorHasSelection && resourceExtname == .md", "group": "inkflow@2" },
        { "command": "inkflow.reviewChapter", "when": "resourceFilename =~ /chapter_\\d+.*\\.md/", "group": "inkflow@3" }
      ]
    },
    "configuration": {
      "title": "墨流 InkFlow",
      "properties": {
        "inkflow.enginePath": {
          "type": "string",
          "default": "",
          "description": "可选：inkflow-engine.exe 的完整路径。留空时自动寻找桌面版或工作区 Python 环境。"
        },
        "inkflow.pythonPath": {
          "type": "string",
          "default": "",
          "description": "可选：用于运行 inkflow.app_server 的 Python 路径。"
        }
      }
    }
  }
}
